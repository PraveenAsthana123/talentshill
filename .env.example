# Required for JWT signing
SESSION_SECRET=

# Admin account setup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# App URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Ollama AI (local)
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MODEL=llama3.2

# Email
SMTP_FROM=noreply@example.com
SALES_ALERT_EMAIL=

# Field encryption (generate: openssl rand -hex 32)
FIELD_ENCRYPT_KEY=

# === Social Links ===
NEXT_PUBLIC_WHATSAPP_NUMBER=+1234567890
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/talentshill
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/talentshill

# === Chatbot / AI ===
CHAT_API_PROVIDER=placeholder
CHAT_API_KEY=your-api-key-here
CHAT_API_BASE_URL=https://api.openai.com/v1

# === Email (placeholder) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@talentshill.com
SMTP_PASS=your-smtp-password

# === Site ===
NEXT_PUBLIC_SITE_URL=https://talentshill.com

# === Admin OAuth Login (Google / Microsoft) ===
# Optional. Admin panel falls back to password-only login (fails closed with
# a "not configured" response) when these are unset. OAuth never creates a
# new admin account -- the signed-in Google/Microsoft account's verified
# email must already exist as a row in `users`, or login is rejected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows both personal and work/school Microsoft accounts. Set to
# a specific Azure AD tenant ID to restrict sign-in to that tenant only.
MICROSOFT_TENANT_ID=common
