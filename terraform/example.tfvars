aws_region   = "us-east-1"
project_name = "talentshill"
environment  = "prod"

# GoDaddy domain (set to enable custom domain + SSL + DNS)
# domain_name = "talentshill.com"

# GoDaddy API credentials (get from https://developer.godaddy.com/keys)
# godaddy_api_key    = "your-api-key"
# godaddy_api_secret = "your-api-secret"

# WAF protection (recommended for production)
enable_waf = true

# Monitoring alerts (set email to enable CloudWatch alarms)
# alert_email = "alerts@talentshill.com"
